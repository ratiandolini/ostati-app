# Demo mode keeps app data in the browser for prototype testing.
# Production-like mode should use:
# REACT_APP_DATA_MODE=api
# REACT_APP_AUTH_MODE=email_password
# REACT_APP_SUPABASE_URL=https://your-project.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=your-anon-or-publishable-key
REACT_APP_DATA_MODE=demo
REACT_APP_AUTH_MODE=email_password
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
